# Copy to .env at repository root for Docker, or apps/api/.env for uv.
ENVIRONMENT=development
POSTGRES_DB=crimestack
POSTGRES_USER=crimestack
POSTGRES_PASSWORD=local-postgres-change-me
DATABASE_URL=sqlite:///./crimestack.db
TOKEN_SECRET=development-only-change-this-token-secret-32
SIGNING_SECRET=development-only-change-this-signing-secret-32
SIGNING_KEY_ID=v1
PREVIOUS_SIGNING_KEYS={}
BOOTSTRAP_SECRET=local-bootstrap-change-me
ACCESS_TOKEN_MINUTES=30
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60
LLM_API_KEY=
LLM_MODEL=
# Optional approved MapLibre v8 RASTER style; configured at frontend build time.
VITE_MAP_STYLE_URL=